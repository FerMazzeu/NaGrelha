{
  "name": "na-grelha-alan-xavier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run imagens && tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "imagens": "node scripts/imagens.mjs",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
